import("../../core/Lynx.gni")

config("browser_filesystem") {
  ldflags = [
    "-sFILESYSTEM=1",
    "-sFORCE_FILESYSTEM=1",
    "-sUSE_ZLIB=1",
    "-g2",
  ]
}

executable("static_canvas") {
  output_extension = "js"
  sources = [ "static_canvas.cc" ]
  include_dirs = [
    "../..",
    "../../third_party/quickjs/src/src/interpreter",
    "../../third_party/quickjs/src/src",
    "../../third_party/rapidjson",
    "../../out/skity-source/include",
    "../../out/skity-source/third_party/glm",
  ]
  defines = [ "NAPI_EXTERN=" ]
  configs += [
    "../../core:lynx_public_config",
    ":browser_filesystem",
  ]
  deps = [
    "../../base/src:base_group",
    "../../core/renderer/starlight",
    "../../third_party/quickjs",
  ]
  cflags = [ "--use-port=emdawnwebgpu" ]
  ldflags = [
    "--use-port=emdawnwebgpu",
    "-sFILESYSTEM=1",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sSTACK_SIZE=2097152",
    "-sASSERTIONS=1",
    "-sEXPORT_NAME=createLynxCanvas",
    "-sSINGLE_FILE=1",
    "-sEXPORTED_FUNCTIONS=['_main','_render_scene','_scene_report','_release_completed_frames']",
    "-sEXPORTED_RUNTIME_METHODS=['ccall','UTF8ToString']",
    "--embed-file",
    rebase_path("scene.js", root_build_dir) + "@/scene.js",
    "--embed-file",
    rebase_path("//out/Roboto-Regular.ttf", root_build_dir) + "@/font.ttf",
  ]
  libs = [
    "c++",
    "//out/skity-wasm/libskity.a",
    "//out/skity-wasm/module/wgx/libwgsl-cross.a",
    "//out/skity-wasm/third_party/pugixml/libpugixml.a",
    "//out/skity-wasm/third_party/jsoncpp/src/lib_json/libjsoncpp.a",
    "//out/skity-wasm/src/libfreetype2.a",
  ]
}

executable("bundle_canvas") {
  output_extension = "js"
  inputs = [
    "app/dist/main.lynx.bundle",
    "//out/lynx_core.js",
    "//out/Roboto-Regular.ttf",
    "//out/NotoSansSC.ttf",
    "//out/NotoSansArabic.ttf",
    "//out/NotoEmoji.ttf",
    "//out/textra-wasm/liblynx_browser_tttext.a",
  ]
  sources = [
    "../../core/renderer/utils/lynx_trail_hub_impl_default.cc",
    "../../core/services/event_report/event_tracker_platform_impl.cc",
    "browser_bts_delegate.cc",
    "browser_bts_worker.cc",
    "browser_images.cc",
    "browser_message_loop.cc",
    "browser_platform.cc",
    "browser_text.cc",
    "devtool/native.cc",
    "bundle_canvas.cc",
  ]
  include_dirs = [
    "../..",
    "../../third_party/quickjs/src/src/interpreter",
    "../../third_party/quickjs/src/src",
    "../../third_party/rapidjson",
    "../../out/skity-source/include",
    "../../out/textra-source/public",
    "../../out/skity-source/third_party/jsoncpp/include",
    "../../out/skity-source/third_party/glm",
  ]
  defines = [ "NAPI_EXTERN=" ]
  configs += [
    "../../core:lynx_public_config",
    ":browser_filesystem",
  ]
  deps = [
    "../../base/src:base_group",
    "../../core:lynx_native",
    "../../third_party/quickjs",
  ]
  cflags = [ "--use-port=emdawnwebgpu" ]
  ldflags = [
    "--use-port=emdawnwebgpu",
    "-sUSE_HARFBUZZ=1",
    "-sFILESYSTEM=1",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sSTACK_SIZE=2097152",
    "-sPTHREAD_POOL_SIZE=1",
    "-sINITIAL_MEMORY=33554432",
    "-sALLOW_BLOCKING_ON_MAIN_THREAD=0",
    "-sASSERTIONS=1",
    "-sEXPORT_NAME=createLynxCanvas",
    "-sSINGLE_FILE=1",
    "-sEXPORTED_FUNCTIONS=['_main','_render_scene','_scene_report','_release_completed_frames','_verify_corrupt_bundle','_load_bundle','_bundle_load_error','_malloc','_free','_dispatch_pointer','_tick','_needs_frame','_render_frame','_release_frames','_host_error_count','_image_allocate','_image_complete','_image_playback_event','_test_bts_busy','_devtool_dispatch']",
    "-sEXPORTED_RUNTIME_METHODS=['ccall','UTF8ToString','HEAPU8','WebGPU']",
    "--embed-file",
    rebase_path("app/dist/main.lynx.bundle", root_build_dir) +
        "@/main.lynx.bundle",
    "--embed-file",
    rebase_path("//out/lynx_core.js", root_build_dir) + "@/lynx_core.js",
    "--embed-file",
    rebase_path("//out/Roboto-Regular.ttf", root_build_dir) + "@/font.ttf",
    "--embed-file",
    rebase_path("//out/NotoSansSC.ttf", root_build_dir) + "@/cjk.ttf",
    "--embed-file",
    rebase_path("//out/NotoSansArabic.ttf", root_build_dir) + "@/arabic.ttf",
    "--embed-file",
    rebase_path("//out/NotoEmoji.ttf", root_build_dir) + "@/emoji.ttf",
  ]
  libs = [
    "c++",
    "//out/skity-wasm/libskity.a",
    "//out/textra-wasm/liblynx_browser_tttext.a",
    "//out/skity-wasm/module/wgx/libwgsl-cross.a",
    "//out/skity-wasm/third_party/pugixml/libpugixml.a",
    "//out/skity-wasm/third_party/jsoncpp/src/lib_json/libjsoncpp.a",
    "//out/skity-wasm/src/libfreetype2.a",
  ]
}
